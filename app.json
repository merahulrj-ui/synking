{
  "expo": {
    "name": "Synkin",
    "slug": "synkon",
    "version": "1.0.69",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "synking",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.synking",
      "bitcode": false,
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "package": "com.synking",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FD3A73",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "WAKE_LOCK",
        "VIBRATE",
        "SYSTEM_ALERT_WINDOW",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_PHONE_CALL",
        "FOREGROUND_SERVICE_SPECIAL_USE",
        "USE_FULL_SCREEN_INTENT",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow SYNKING to access your camera for HD Video Calling.",
          "microphonePermission": "Allow SYNKING to access your microphone for HD Voice Calling."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7991a7fd-8364-4a1c-a332-90ca559d0128"
      }
    },
    "owner": "merahulrj",
    "updates": {
      "url": "https://u.expo.dev/7991a7fd-8364-4a1c-a332-90ca559d0128"
    }
  }
}
